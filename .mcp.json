{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "x",
        "@playwright/mcp@0.0.79",
        "--config",
        "./playwright-mcp.json",
        "--output-dir",
        ".playwright-mcp"
      ],
      "env": {}
    },
    "shadcn": {
      "type": "stdio",
      "command": "bun",
      "args": ["x", "shadcn", "mcp"],
      "env": {}
    }
  }
}
