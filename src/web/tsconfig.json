{
  "compilerOptions": {
    // Incremental, so the second typecheck of a loop costs about a third of the
    // first (measured: 2.5s -> 0.95s, 3.5s -> 1.19s, 3.0s -> 1.19s). The cache
    // lives outside the source tree and is gitignored; `mise run typecheck:clean`
    // ignores it, and that is what the pre-commit gate runs.
    "incremental": true,
    "tsBuildInfoFile": "../../.tsbuildinfo/spa.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    /**
     * A type import must say `import type`, and is then provably erased.
     *
     * src/web/sw.ts imports `PushBody` from src/api/push.ts so the service
     * worker and the sender cannot drift. That is safe only while the import
     * erases — a *value* import from src/api would drag drizzle and the Worker
     * runtime into a bundle that runs on somebody's phone.
     *
     * That safety was checked once, by hand, by grepping the built sw.js. This
     * makes it a build-time invariant instead: the natural temptation is a
     * shared const alongside the type, and without this nothing would object
     * until the bundle grew. Zero errors when it was turned on — the codebase
     * already wrote `import type` everywhere, so this locks in a discipline
     * rather than imposing one.
     */
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    // On since 2026-08-27, along with the Worker's. It found nine dead imports
    // here, all of them left behind by the react-query refactor that deleted the
    // useState/useEffect they belonged to. knip checks orphan FILES, not unused
    // imports inside a live one, and there is no linter in this repo.
    // noUnusedParameters stays off: a React handler that ignores its event
    // argument is normal, and the noise would bury the signal above.
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true
  },
"include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"]
}
