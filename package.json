{
  "name": "remy-sport",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "bun scripts/lib/prepare.ts local",
    "dev": "bun scripts/dev.ts",
    "typecheck": "tsc",
    "lint": "knip --include files,unlisted --no-config-hints && depcruise src --config .dependency-cruiser.cjs && eslint src/web && inlang validate --project ./project.inlang",
    "check:model": "bun scripts/ops/domain.ts --check && bun scripts/lib/seed.ts --check && bun scripts/ops/coverage-gui.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "playwright test --config playwright.render.config.ts",
    "test:e2e": "bun scripts/e2e.ts",
    "check": "bun run typecheck && bun run lint && bun run check:model && bun run test && bun run test:render",
    "build": "vite build --config src/web/vite.config.ts",
    "shots": "playwright test --project shots --reporter list --retries 0",
    "deploy": "bun scripts/deploy.ts",
    "db": "bun scripts/db.ts",
    "ops": "bun scripts/ops.ts",
    "model": "bun scripts/model.ts"
  },
  "dependencies": {
