    "hono": "^4.13.7",
    "lit": "^3.3.3",
    "openapi-types": "^12.1.3",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@inlang/cli": "^3.3.4",
    "@inlang/paraglide-js": "2.25.0",
