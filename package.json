    "@orpc/openapi": "1.15.0",
    "@orpc/openapi-client": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@tanstack/query-core": "^5.102.8",
