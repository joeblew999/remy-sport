{
  "name": "remy-sport",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "bun scripts/lib/prepare.ts local",
    "dev": "vite --config src/web/vite.config.ts",
    "preview": "vite preview --config src/web/vite.config.ts",
    "typecheck": "tsc",
    "lint": "knip --include files,unlisted --no-config-hints",
    "check:model": "bun scripts/ops/domain.ts --check && bun scripts/ops/coverage-gui.ts",
    "test": "vitest run",
    "test:ship": "vitest run --exclude '**/docs.test.ts' --exclude '**/docs-organisation.test.ts' --exclude '**/node_modules/**'",
    "test:watch": "vitest",
    "test:render": "playwright test --config playwright.render.config.ts",
    "test:e2e": "bun scripts/e2e.ts",
    "check": "bun scripts/lib/prepare.ts && bun run typecheck && bun run lint && bun run build && bun run check:model && bun run test && bun run test:render",
    "check:ship": "bun scripts/lib/prepare.ts && bun run typecheck && bun run lint && bun run build && bun run check:model && bun run test:ship && bun run test:render",
    "build": "bun scripts/build.ts",
    "shots": "bun scripts/e2e.ts --shots --reporter list --retries 0",
    "deploy": "bun scripts/deploy.ts",
    "db": "bun scripts/db.ts",
    "ops": "bun scripts/ops.ts",
    "model": "bun scripts/model.ts",
    "test:relay": "bun tests/integration/moq-scope.ts",
    "live": "bun scripts/live.ts"
  },
  "dependencies": {
    "@khmyznikov/pwa-install": "0.6.4",
    "@moq/publish": "^0.4.6",
    "@moq/watch": "^0.5.3",
    "@orpc/client": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/openapi-client": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@react-email/components": "1.0.12",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "input-otp": "^1.5.0",
    "lit": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@inlang/paraglide-js": "2.25.0",
    "@moq/net": "0.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.34.0",
    "lucide-react": "^1.42.0",
    "oxc-parser": "^0.148.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4",
    "workbox-precaching": "^7.4.1",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "sharp": "0.35.2"
  },
  "patchedDependencies": {
    "@moq/net@0.3.4": "patches/@moq%2Fnet@0.3.4.patch"
  }
