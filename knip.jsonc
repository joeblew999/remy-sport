{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code detection (ADR 020).
  //
  // This exists because the oRPC migration in c4d326a left orphaned files
  // behind — three Hono middlewares reimplemented as oRPC middleware, plus a
  // Crest component that styles.css had already replaced with CSS. All were
  // found by hand-grepping, which is slow and misses things.
  //
  // .jsonc, not .json: knip validates keys strictly and rejects "//" comment
  // keys, and a config whose reasoning lives elsewhere is one nobody maintains.
  //
  // `mise run check` runs this with --include files,unlisted. That scope is
  // deliberate — see the task in mise.toml for why unused *exports* are
  // reported but not enforced.

  // Three entry points, because this repo has three: the Worker, the SPA, and
  // the scripts mise runs. Specs count — a helper used only by tests is live.
  // vite.config.ts is an entry too: it is passed to `vite --config`, so nothing
  // imports it and it is not dead.
  //
  // `*.shots.ts` for the same reason as the configs: playwright.shots.config.ts
  // selects it with a regex rather than importing it, so nothing in the graph
  // points at it and knip reads that as dead.
  //
  // `src/web/sw.ts` is an entry for the same reason once removed: it is named
  // as a string in vite.config.ts (`filename: "sw.ts"`) and compiled as its own
  // bundle by vite-plugin-pwa's injectManifest, so nothing imports it either.
  // It is the service worker — the app's push handler and offline cache.
  "entry": [
    "src/web/main.tsx",
    "src/web/sw.ts",
    "src/web/vite.config.ts",
    "src/auth.cli.ts",
    "scripts/*.ts",
    // scripts/checks/*.ts are the gate's steps. They are entry points like any
    // other script here — check.ts spawns them by path rather than importing
    // them, so nothing in the graph reaches them and knip calls all eleven dead.
    "scripts/checks/*.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "tests/**/*.setup.ts",
    "tests/**/*.shots.ts"
  ],

  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.ts"],

  // GENERATED (mise run auth:schema:generate / domain:generate). They export
  // their source's full surface on purpose, so partial use is correct, not
  // dead — and deleting an "unused" export is undone by the next regeneration.
  "ignore": [
    "src/db/auth-schema.ts",
    "src/db/fixtures-schema.ts",
    "src/domain/vocabularies.ts"
  ],

  // Invoked as binaries by mise tasks, never imported. `auth` is the Better
  // Auth CLI — see AGENTS.md on why it versions in lockstep with core.
  // `cloudflare:test` is a virtual module the workers pool injects at runtime,
  // not a package — knip sees the `cloudflare` specifier and calls it unlisted.
  "ignoreDependencies": ["auth", "vite", "wrangler", "@tauri-apps/cli", "cloudflare"],

  // mise is the task runner itself; scripts/cf-ensure.ts shells out to it.
  "ignoreBinaries": ["mise"]
}
