{
  // One configuration for everything: the Worker, the SPA, the tests and the
  // scripts. There were three, each with its own target and lib, and the SPA's
  // was still ES2020 in 2026 — which is how `Error.cause` became a type error
  // the day TypeScript 6 checked the lib properly. One target, one lib, one
  // `tsc`, and nothing to keep in step.
  //
  // The Worker has no JSX of its own (it once compiled with Hono's), so React's
  // runtime serves the whole tree. The Workers runtime types come from
  // worker-configuration.d.ts, generated by `wrangler types` for the exact
  // compatibility date in wrangler.toml; the DOM lib sits beside them as it
  // always did.
  "compilerOptions": {
    // Vite emits for its own baseline (Safari 16 and up); this only has to be
    // no older than that.
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    // An import left behind when the thing it imported moves. knip checks
    // orphan files and unlisted dependencies, not unused imports inside a live
    // file. noUnusedParameters stays off: a React handler that ignores its event
    // argument is normal, and the noise would bury the signal.
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // A type import must say `import type`, and is then provably erased. The
    // service worker imports `PushBody` from src/api/push.ts; a value import
    // there would drag drizzle and the Worker runtime into a bundle that runs
    // on somebody's phone.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // `@/` is the SPA. shadcn's registry writes components that import
    // `@/lib/utils` and `@/components/ui/...` (components.json `aliases`), so
    // the alias is theirs to keep, not a style choice of ours; vite.config.ts
    // carries the same mapping for the bundler.
    "paths": { "@/*": ["./src/web/*"] },
    // Vite's native config loader wants the extension on an import, and with
    // `noEmit` there is nothing an extension could mislead.
    "allowImportingTsExtensions": true,
    // src/paraglide is generated JavaScript carrying JSDoc types; the Worker and
    // the SPA both import it.
    "allowJs": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["@types/node", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "tests", "scripts", "*.ts", "worker-configuration.d.ts"],
  // paraglide is reached through imports; globbing its hundreds of generated
  // files as roots would only make every typecheck slower.
  "exclude": ["node_modules", "dist", "src/paraglide"]
}
