{
  "compilerOptions": {
    // src/paraglide is generated JavaScript carrying JSDoc types. The Worker
    // imports it because the OTP email is written in the same messages the SPA
    // renders — see src/auth.ts. src/web/tsconfig.json has had this all along.
    "allowJs": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // Catches the import left behind when the thing it imported moves. `drizzle`
    // sat unused in src/api/base.ts after `database` moved to db.ts, and nothing
    // said so: knip checks orphan FILES and unlisted deps, not unused imports
    // inside a live one, and there is no linter here.
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["@types/node"]
  },
  // src/web is excluded because it is React: it has its own tsconfig with
  // `jsxImportSource: react`, while this one is Hono JSX for the Worker. One
  // config cannot serve both. `.tsx` is included here so a Worker-side
  // component is still typechecked — before this, `src/**/*.ts` silently
  // skipped every .tsx file in the repo, which is how a page kept rendering a
  // field that no longer existed.
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "src/web"]
}
