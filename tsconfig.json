{
  "compilerOptions": {
    // Incremental, so the second typecheck of a loop costs about a third of the
    // first (measured: 2.5s -> 0.95s, 3.5s -> 1.19s, 3.0s -> 1.19s). The cache
    // lives outside the source tree and is gitignored; `mise run typecheck:clean`
    // ignores it, and that is what the pre-commit gate runs.
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo/worker.tsbuildinfo",
    // src/paraglide is generated JavaScript carrying JSDoc types. The Worker
    // imports it because the OTP email is written in the same messages the SPA
    // renders — see src/auth.ts. src/web/tsconfig.json has had this all along.
    "allowJs": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // Catches the import left behind when the thing it imported moves. `drizzle`
    // sat unused in src/api/base.ts after `database` moved to db.ts, and nothing
    // said so: knip checks orphan FILES and unlisted deps, not unused imports
    // inside a live one, and there is no linter here.
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    /**
     * A type import must say `import type`, and is then provably erased.
     *
     * src/web/sw.ts imports `PushBody` from src/api/push.ts so the service
     * worker and the sender cannot drift. That is safe only while the import
     * erases — a *value* import from src/api would drag drizzle and the Worker
     * runtime into a bundle that runs on somebody's phone.
     *
     * That safety was checked once, by hand, by grepping the built sw.js. This
     * makes it a build-time invariant instead: the natural temptation is a
     * shared const alongside the type, and without this nothing would object
     * until the bundle grew. Zero errors when it was turned on — the codebase
     * already wrote `import type` everywhere, so this locks in a discipline
     * rather than imposing one.
     */
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["@types/node"]
  },
  // src/web is excluded because it is React: it has its own tsconfig with
  // `jsxImportSource: react`, while this one is Hono JSX for the Worker. One
  // config cannot serve both. `.tsx` is included here so a Worker-side
  // component is still typechecked — before this, `src/**/*.ts` silently
  // skipped every .tsx file in the repo, which is how a page kept rendering a
  // field that no longer existed.
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "src/web"]
}
